---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAIL_USER, EMAIL_DOMAIN, SOCIALS } from '../lib/config';

// Shown in full, as a plain string rather than a mailto:. Note this address
// is now scrapeable from the published page — that is the trade for making it
// easy to read and copy. To make it clickable too:
//   <a href={`mailto:${email}`}>{email}</a>
const email = `${EMAIL_USER}@${EMAIL_DOMAIN}`;
---
<BaseLayout title="Contact" description="How to get in touch with me.">
  <h1>Contact</h1>

  <p>
    Happy to hear about a proof you liked, an error you spotted, or anything
    you're working on. The fastest way to reach me is email:
  </p>

  <p class="contact-email">{email}</p>

  {SOCIALS.length > 0 && (
    <>
      <h2>Elsewhere</h2>
      <ul class="contact-links">
        {SOCIALS.map((s) => (
          <li>
            <span class="contact-links__label">{s.label}</span>
            <a href={s.url} rel="me noopener" target="_blank">{s.handle}</a>
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>
