---
import fs from 'node:fs';
import path from 'node:path';
import { withBase } from '../lib/url';
import { AUTHOR, SITE_START_YEAR, GOATCOUNTER_CODE } from '../lib/config';
import FlipName from '../components/FlipName.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** schema.org JSON-LD for this page, if it has any. */
  jsonLd?: Record<string, unknown>;
}
const { title, description, jsonLd } = Astro.props;
// Astro.url.pathname already includes the base path — do NOT wrap in withBase.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const SITE_NAME = 'Math Proofs & Devlogs';
// The home page is its own title; inner pages get suffixed.
const pageTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;

// Only link the resume once the file is actually there. Drop a PDF at
// public/resume.pdf and the button appears on the next build; without this
// the nav would advertise a 404.
//
// Resolved from the project root, not import.meta.url: this component gets
// bundled before it runs, so a path relative to the module lands somewhere
// inside the build output and the check silently never fires.
const hasResume = fs.existsSync(path.join(process.cwd(), 'public', 'resume.pdf'));

const currentYear = new Date().getFullYear();
const copyrightYears =
  currentYear > SITE_START_YEAR ? `${SITE_START_YEAR}–${currentYear}` : `${SITE_START_YEAR}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={withBase('/rss.xml')} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    )}
    {GOATCOUNTER_CODE && (
      <script
        data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-title" href={withBase('/')} aria-label="ThoughtlessNerd — home">
          <FlipName />
        </a>
        <nav class="site-nav">
          <a href={withBase('/')}>Home</a>
          <a href={withBase('/about/')}>About</a>
          <a href={withBase('/contact/')}>Contact</a>
          {hasResume && <a href={withBase('/resume.pdf')}>Resume</a>}
          <a href={withBase('/rss.xml')}>RSS</a>
        </nav>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>Math proofs done for fun, and the occasional devlog.</span>
        <small class="site-footer__copyright">
          © {copyrightYears} {AUTHOR}. All rights reserved.
        </small>
      </div>
    </footer>
  </body>
</html>
