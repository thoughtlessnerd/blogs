---
import fs from 'node:fs';
import path from 'node:path';
import { withBase } from '../lib/url';
import { AUTHOR, SITE_START_YEAR, GOATCOUNTER_CODE } from '../lib/config';
import FlipName from '../components/FlipName.astro';
import Backdrop from '../components/Backdrop.astro';
import '../styles/journal.css';

interface Props {
  title: string;
  description: string;
  /** schema.org JSON-LD for this page, if it has any. */
  jsonLd?: Record<string, unknown>;
  /** Root-relative path to this page's social card; defaults to the site card. */
  ogImage?: string;
}
const { title, description, jsonLd, ogImage } = Astro.props;
// Astro.url.pathname already includes the base path — do NOT wrap in withBase.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const SITE_NAME = 'Math Proofs & Devlogs';
// The home page is its own title; inner pages get suffixed.
const pageTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;

// Only link the resume once the file is actually there. Drop a PDF at
// public/resume.pdf and the button appears on the next build; without this
// the nav would advertise a 404.
//
// Resolved from the project root, not import.meta.url: this component gets
// bundled before it runs, so a path relative to the module lands somewhere
// inside the build output and the check silently never fires.
const hasResume = fs.existsSync(path.join(process.cwd(), 'public', 'resume.pdf'));

// og:image must be an absolute URL — relative paths are ignored by every
// major platform's crawler.
const ogImageURL = new URL(withBase(ogImage ?? '/og/site.png'), Astro.site).href;

// Which nav item is highlighted. Astro.url.pathname carries the base and a
// trailing slash, so both are stripped before matching.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const stripped = Astro.url.pathname.replace(/\/+$/, '');
const route = (stripped.startsWith(base) ? stripped.slice(base.length) : stripped) || '/';

// Home covers the writing itself, not just the index: a post or an archive
// page is reached through Home, and leaving the whole nav unlit while reading
// a post tells the visitor nothing about where they are.
const NAV = [
  {
    label: 'Home',
    href: '/',
    active: route === '/' || route.startsWith('/posts') || route.startsWith('/archive'),
  },
  { label: 'About', href: '/about/', active: route === '/about' },
  { label: 'Contact', href: '/contact/', active: route === '/contact' },
];

const currentYear = new Date().getFullYear();
const copyrightYears =
  currentYear > SITE_START_YEAR ? `${SITE_START_YEAR}–${currentYear}` : `${SITE_START_YEAR}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <!-- Dark only: the site has no light palette, so advertising one would
         have the browser style native controls for a theme that never comes. -->
    <meta name="color-scheme" content="dark" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={withBase('/rss.xml')} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    )}
    {GOATCOUNTER_CODE && (
      <script
        data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"></script>
    )}
  </head>
  <body>
    <Backdrop />
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-title" href={withBase('/')} aria-label="ThoughtlessNerd — home">
          <FlipName />
        </a>
        <nav class="site-nav">
          {NAV.map((item) => (
            <a href={withBase(item.href)} aria-current={item.active ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          {/* The resume and the feed are files, not pages of this site, so
              neither ever takes the current-page state, and both open in a new
              tab — clicking RSS otherwise strands the reader on raw XML with
              only the back button out. rel="noopener" is implied by modern
              browsers for target="_blank", but stated so it does not depend on
              that. The labels say so aloud for screen readers, which otherwise
              get no warning that focus is about to move. */}
          {hasResume && (
            <a
              href={withBase('/resume.pdf')}
              target="_blank"
              rel="noopener"
              aria-label="Resume (opens in a new tab)">Resume</a>
          )}
          <a
            href={withBase('/rss.xml')}
            target="_blank"
            rel="noopener"
            aria-label="RSS feed (opens in a new tab)">RSS</a>
        </nav>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>Math proofs done for fun, and the occasional devlog.</span>
        <small class="site-footer__copyright">
          © {copyrightYears} {AUTHOR}. All rights reserved.
        </small>
      </div>
    </footer>
  </body>
</html>
